{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@varve/core": ["../../packages/core/src/index.ts"],
      "@varve/store": ["../../packages/store/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
