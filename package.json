{
  "name": "varve-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/store packages/retirement packages/legacy-import",
    "typecheck": "pnpm build",
    "test": "pnpm -r test",
    "reconcile": "pnpm --filter @varve/legacy-import reconcile",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo apps/*/dist",
    "snapshot": "pnpm --filter @varve/legacy-import snapshot"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
